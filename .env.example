# Copy this file to .env and fill in your values before running the server.
# .env is listed in .gitignore and must NEVER be committed.

# Required — your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional — LLM model to use for generation and reranking (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional — set a random secret string to require X-API-Key header on all endpoints.
# Leave blank to allow unauthenticated access (suitable for local development only).
AUDITOR_API_KEY=

# Optional — LangSmith observability tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
